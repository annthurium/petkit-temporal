# Settings for scripts/cloud-setup.sh and scripts/deploy.sh.
# Copy to .env.cloud (gitignored) and fill in.
#
# Secrets in this file are only read locally, to create Secret Manager
# secrets and to run the Temporal CLI. Cloud Run gets them from Secret Manager.

# --- Google Cloud ---
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
REGION="us-west1"                 # Temporal Cloud on GCP region; keep everything here
FIRESTORE_DATABASE="petkit"

# --- Temporal Cloud ---
TEMPORAL_ADDRESS="us-west1.gcp.api.temporal.io:7233"
TEMPORAL_NAMESPACE="your-namespace.your-account-id"
TEMPORAL_API_KEY="..."
TEMPORAL_TASK_QUEUE="petkit-tasks"
# Created by the Temporal Terraform module (see docs/deploy.md, step 3).
TEMPORAL_INVOKER_SA="temporal-invoker@your-gcp-project-id.iam.gserviceaccount.com"

# --- PetKit ---
PETKIT_USERNAME="your-petkit-email"
PETKIT_PASSWORD="your-petkit-password"
PETKIT_REGION="US"
PETKIT_TIMEZONE="America/Los_Angeles"
FEED_SKIP_WINDOW_HOURS="12"
