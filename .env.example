PETKIT_USERNAME="your-petkit-email"
PETKIT_PASSWORD="your-petkit-password"
PETKIT_REGION="US"
PETKIT_TIMEZONE="America/Los_Angeles"
# Local development talks to `temporal server start-dev`. Temporal Cloud
# settings for deployment go in .env.cloud (see .env.cloud.example).
TEMPORAL_ADDRESS="localhost:7233"
TEMPORAL_NAMESPACE="default"
TEMPORAL_TASK_QUEUE="petkit-tasks"

# Firestore holds device snapshots the worker writes and the API reads (ADR 0006)
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
FIRESTORE_DATABASE="petkit"  # named database in the same region as Temporal Cloud
