rules_version = '2';

// Deny all client (browser/mobile) access. Only the backend reads and writes
// Firestore, through the server library with IAM credentials, which bypasses
// these rules. See docs/adr/0007-browser-reads-through-the-api.md.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
